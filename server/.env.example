# Server-only. Use a local MongoDB or your own Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/codearena26
PORT=3001
HOST=127.0.0.1
# Serve the production frontend from Express after npm run build.
SERVE_CLIENT=false
# For an HTTPS deployment, set NODE_ENV=production to issue Secure session cookies.
# Leave unset for local HTTP development. Sessions/password hashes are stored in MongoDB.
# Only needed for the opt-in local image smoke test. Select an available image-input model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
