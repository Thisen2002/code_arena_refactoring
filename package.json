{
  "name": "codearena26-disaster-response",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "npm run test -w server",
    "test:persistence": "npm run test:persistence -w server",
    "test:m4": "npm run test:m4 -w server",
    "test:m5": "npm run test:m5 -w server",
    "test:m6": "npm run test:m6 -w server",
    "test:e2e": "npm run test:e2e -w server",
    "demo:reset": "npm run demo:reset -w server",
    "smoke:gemini": "npm run smoke:gemini -w server --",
    "seed:demo": "npm run seed:demo -w server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "mongodb": "^7.6.0"
  }
}
